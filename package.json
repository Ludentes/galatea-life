{
  "name": "galatea-life",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "test:fast": "pnpm -r build && pnpm -r --workspace-concurrency=2 --no-bail --filter '!@ludentes/galatea-life-install' --filter '!galatea-life' test",
    "test:install": "pnpm --filter @ludentes/galatea-life-install test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredOptionalDependencies": [
      "usocket"
    ],
    "overrides": {
      "zigbee-herdsman": "10.10.0"
    }
  }
}
