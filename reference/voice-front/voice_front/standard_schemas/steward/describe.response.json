{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward/describe.response.json",
  "type": "object",
  "required": ["steward_id", "standard_version", "revision", "home", "rooms", "targets", "groups", "endpoints",
               "persons", "scenarios", "rules", "schedules", "modes", "applier"],
  "properties": {
    "steward_id": { "type": "string" },
    "standard_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "revision": { "type": "integer" },
    "home": {
      "type": "object",
      "description": "The home's settings; a front sees only audio_retention_s and other_wake_words (GA-AUTH-8), every other reader the hold policy in force (GA-LEASE-8)",
      "properties": { "hold": { "$ref": "../common.json#/$defs/holdPolicy" } }
    },
    "rooms": { "type": "array" },
    "targets": { "type": "array" },
    "groups": { "type": "array" },
    "endpoints": { "type": "array" },
    "persons": {
      "description": "Persons by id, name and role only (steward, Operations), and by id only to a front (GA-AUTH-8)",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "role": { "$ref": "../common.json#/$defs/personRole" } }
      }
    },
    "scenarios": { "type": "array" },
    "rules": { "type": "array" },
    "schedules": { "type": "array" },
    "modes": { "type": "array" },
    "applier": {
      "type": "object",
      "required": ["applier_id", "levels", "ungoverned"],
      "properties": {
        "applier_id": { "type": "string" },
        "levels": { "type": "array", "items": { "type": "string" } },
        "ungoverned": { "type": "array" }
      }
    },
    "edge_replay_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 300, "description": "The bound on replaying an edge from a gap, at most 300 s; absent when the steward replays none (GA-RULE-1)" },
    "safety_lease_s": { "type": "number", "exclusiveMinimum": 0, "description": "The bound on a latchless safety lease; absent when the steward never ends one early (GA-LEASE-6)" },
    "held_notices": { "type": "integer", "minimum": 0, "description": "The count of notices held, shown while no channel has notify (GA-NOTE-1)" },
    "test_run_id": { "type": "string" }
  }
}
