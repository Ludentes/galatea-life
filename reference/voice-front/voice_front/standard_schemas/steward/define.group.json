{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward/define.group.json",
  "title": "A define change's value for kind group (steward, Change sets); created with name, room, members, aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "$ref": "../common.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "room": {
      "oneOf": [
        {
          "$ref": "../common.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "aggregate": {
      "enum": [
        "any",
        "all"
      ]
    }
  }
}
