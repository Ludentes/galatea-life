{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward/outcome.response.json",
  "type": "object",
  "required": ["apply_id", "outcomes"],
  "properties": {
    "apply_id": { "type": "string" },
    "outcomes": {
      "type": "array",
      "items": { "allOf": [{ "$ref": "../applier/outcome.json" }, { "required": ["time"] }] }
    }
  }
}
