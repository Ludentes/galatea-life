{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward/answer.request.json",
  "type": "object",
  "required": ["plan_id", "endpoint", "answers"],
  "properties": {
    "plan_id": { "type": "string" },
    "endpoint": { "type": "string" },
    "speaker": { "type": "string" },
    "utterance": { "$ref": "../common.json#/$defs/utteranceRecord" },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "../common.json#/$defs/answer" }
    }
  }
}
