{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward/define.credential.json",
  "title": "A define change's value for kind credential: an app or panel names its one endpoint; a brain may carry its own confirm_on (steward, Change sets); created with kind, secret",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "$ref": "../common.json#/$defs/credentialKind"
    },
    "secret": {
      "type": "string",
      "minLength": 16
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "confirm_on": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
