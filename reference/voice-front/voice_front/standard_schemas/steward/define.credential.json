{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward/define.credential.json",
  "title": "A define change's value for kind credential: an app or panel names its one endpoint; a brain may carry its own confirm_on (provisional until the standard names the shape)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "secret"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "$ref": "../common.json#/$defs/credentialKind" },
    "secret": { "type": "string", "minLength": 16 },
    "endpoint": { "type": "string", "minLength": 1 },
    "confirm_on": { "type": "string", "minLength": 1 }
  }
}
