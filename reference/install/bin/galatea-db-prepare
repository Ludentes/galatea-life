#!/usr/bin/env bash
# Prepares the store's files on the host, before `docker compose up`:
# - a random password for `postgres`, `reader` and every listed instance that
#   has none yet (a password that exists is never changed);
# - a broker password for every listed instance, its identity on the broker, in
#   secrets/broker, kept the same way and never the store's;
# - the Zigbee bridge's data directory, when bridge_zigbee is listed: yours, closed to
#   others, since it holds the network key, and Docker would make a missing one as root;
# - the backups directory, owned by you and closed to others. Docker would create a missing one as
#   root, and the backup service, which runs as you, could not write to it.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/lib.sh"

secrets=$(resolve "${GALATEA_DB_SECRETS:-./secrets/db}")
broker_secrets=$(resolve "${GALATEA_BROKER_SECRETS:-./secrets/broker}")
instances=$(resolve "${GALATEA_INSTANCES:-./instances}")
backups=$(resolve "${GALATEA_BACKUPS:-./backups}")
zigbee=$(resolve "${GALATEA_ZIGBEE_DATA:-./zigbee}")
[ -f "$instances" ] || die "no instances file: $instances"

# Check every name before writing anything: a name is also a file name.
for n in $(instance_names "$instances"); do
  echo "$n" | grep -Eq '^[a-z][a-z0-9_]{0,62}$' || die "bad instance name: $n"
done

mkdir -p "$secrets" "$broker_secrets" "$backups"
chmod 700 "$secrets" "$broker_secrets" "$backups"
password() {
  [ -s "$1" ] && return 0
  (umask 077 && head -c 48 /dev/urandom | base64 | tr -d '/+=\n' | head -c 32 >"$1")
  echo "galatea-db-prepare: wrote $1"
}
for n in postgres reader $(instance_names "$instances"); do
  password "$secrets/$n"
done
for n in $(instance_names "$instances"); do
  password "$broker_secrets/$n"
done
if instance_names "$instances" | grep -qx bridge_zigbee; then
  mkdir -p "$zigbee"
  chmod 700 "$zigbee"
fi
