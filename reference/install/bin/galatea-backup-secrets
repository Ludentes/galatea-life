#!/usr/bin/env bash
# The secrets archive (the install-core design, *Credentials*): what a restore needs beside the
# nightly dump. Writes install-<time>.tar of secrets/, tls/, instances and .env, mode 0600, into
# GALATEA_SECRETS_BACKUPS (./backups-secrets, 0700, yours), never into backups/, which the backup
# service mounts: no service mounts this directory. The archive is checked by listing it and finding
# every file it should hold, non-empty. The newest Zigbee network backup (galatea-zigbee backup, in
# zigbee/ beside the archives) goes in too, as it holds the network key.
# With GALATEA_SECRETS_RECIPIENT set (an age public key whose
# private half you keep off this box), it is encrypted with `age` (Debian's package) to that key, as
# install-<time>.tar.age, and the box keeps no readable copy. Keeps the newest GALATEA_BACKUP_KEEP.
# Run it nightly from your crontab, after the dump (the README gives the line).
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/lib.sh"
[ $# -eq 0 ] || die "usage: galatea-backup-secrets"
umask 077

secrets=$(resolve "${GALATEA_SECRETS:-./secrets}")
tls=$(resolve "${GALATEA_TLS:-./tls}")
instances=$(resolve "${GALATEA_INSTANCES:-./instances}")
dir=$(resolve "${GALATEA_SECRETS_BACKUPS:-./backups-secrets}")
keep="${GALATEA_BACKUP_KEEP:-14}"
recipient="${GALATEA_SECRETS_RECIPIENT:-}"
case "$keep" in '' | *[!0-9]* | 0) die "GALATEA_BACKUP_KEEP must be a positive integer, not '$keep'" ;; esac
for p in "$secrets" "$tls" "$instances" "$env_file"; do [ -e "$p" ] || die "no $p"; done
[ -z "$recipient" ] || command -v age >/dev/null || die "GALATEA_SECRETS_RECIPIENT is set, and age is not installed (sudo apt install age)"
mkdir -p "$dir"
chmod 700 "$dir"
backups=$(resolve "${GALATEA_BACKUPS:-./backups}")
[ "$(readlink -f "$dir")" != "$(readlink -f "$backups")" ] || die "GALATEA_SECRETS_BACKUPS is the backups directory, which the backup service mounts"

zigbee=$(cd "$dir" && ls -1 zigbee/zigbee-*.json zigbee/zigbee-*.json.age 2>/dev/null | sort | tail -n 1 || true)
extra=()
[ -z "$zigbee" ] || extra=(-C "$dir" "$zigbee")
name="install-$(date -u +%Y%m%dT%H%M%SZ).tar"
tmp="$dir/.$name.partial"
trap 'rm -f "$tmp" "$tmp.age"' EXIT
tar -cf "$tmp" -C "$(dirname "$secrets")" "$(basename "$secrets")" -C "$(dirname "$tls")" "$(basename "$tls")" \
  -C "$(dirname "$instances")" "$(basename "$instances")" -C "$(dirname "$env_file")" "$(basename "$env_file")" \
  "${extra[@]}"

# The check: every file it should hold is in the archive, and none is empty.
listing=$(tar -tvf "$tmp" | awk '$1 ~ /^-/ && $3 > 0 { print $NF }')
want=$( (cd "$(dirname "$secrets")" && find "$(basename "$secrets")" -type f ! -name '*.partial')
  (cd "$(dirname "$tls")" && find "$(basename "$tls")" -type f)
  basename "$instances"; basename "$env_file"; [ -z "$zigbee" ] || echo "$zigbee")
missing=$(comm -23 <(printf '%s\n' "$want" | sort) <(printf '%s\n' "$listing" | sort))
[ -z "$missing" ] || die "the archive misses or holds empty: $(echo $missing); nothing kept"
count=$(printf '%s\n' "$want" | wc -l)

final="$dir/$name"
if [ -n "$recipient" ]; then
  age -r "$recipient" <"$tmp" >"$tmp.age"
  [ "$(head -c 21 "$tmp.age")" = "age-encryption.org/v1" ] || die "age wrote no archive; nothing kept"
  final="$final.age"
  mv "$tmp.age" "$final"
  rm -f "$tmp"
else
  mv "$tmp" "$final"
fi
chmod 600 "$final"
echo "galatea-backup-secrets: $(basename "$final"): ok ($count files)"

# The newest $keep archives are kept.
ls -1 "$dir"/install-*.tar* 2>/dev/null | sort | head -n -"$keep" | while read -r old; do rm -f "$old"; done
