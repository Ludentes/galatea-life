#!/usr/bin/env bash
# A brain's credential (the install-core design, *How the owner and a brain reach the steward*):
#   galatea-secret <id>                    makes secrets/mcp/<id> (32 random letters and digits) once;
#                                          an existing one is never changed
#   galatea-secret <id> --for <account>    also installs, in that account's ~/.config/galatea/, a copy
#                                          of the credential owned by it (0600) and of tls/ca.pem (0644),
#                                          through `sudo install`, the one step that needs root
# The owner's tool reads secrets/mcp/<id> to define it at the steward
# (`galatea credential <id> --kind brain`). The brain's account reads its two copies and nothing of
# the installation. The account must not be yours, root's, or in the docker group.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage="usage: galatea-secret <id> [--for <account>]"
[ $# -eq 1 ] || [ $# -eq 3 ] || die "$usage"
id=$1
account=""
if [ $# -eq 3 ]; then
  [ "$2" = --for ] || die "$usage"
  account=$3
fi
echo "$id" | grep -Eq '^[a-z][a-z0-9_-]{0,62}$' || die "bad credential id: $id (lower case letters, digits, _ and -)"
case "$id" in
  applier-owner | steward-owner | steward-at-applier | steward-token-key | *.next) die "$id is the installation's own secret" ;;
esac

secrets=$(resolve "${GALATEA_SECRETS:-./secrets}")
tls=$(resolve "${GALATEA_TLS:-./tls}")
mcp="$secrets/mcp"
[ -d "$mcp" ] || die "no $mcp (run bin/galatea-prepare)"
f="$mcp/$id"
if [ ! -s "$f" ]; then
  (umask 077 && head -c 48 /dev/urandom | base64 | tr -d '/+=\n' | head -c 32 >"$f")
  echo "galatea-secret: wrote $f"
fi
[ -n "$account" ] || exit 0

[ -s "$tls/ca.pem" ] || die "no $tls/ca.pem (run bin/galatea-certs)"
entry=$(getent passwd "$account") || die "no account $account (sudo useradd -m $account)"
IFS=: read -r _ _ uid gid _ home _ <<<"$entry"
[ "$uid" != 0 ] && [ "$uid" != "$(id -u)" ] || die "$account is root or yourself: a brain runs under an account of its own"
if getent group docker | cut -d: -f4 | tr ',' '\n' | grep -qx "$account"; then
  die "$account is in the docker group, which can read every container's mounts: remove it first"
fi
dir="$home/.config/galatea"
sudo install -d -o "$uid" -g "$gid" -m 0700 "$home/.config" "$dir"
sudo install -o "$uid" -g "$gid" -m 0600 "$f" "$dir/$id"
sudo install -o "$uid" -g "$gid" -m 0644 "$tls/ca.pem" "$dir/ca.pem"
echo "galatea-secret: installed $dir/$id and $dir/ca.pem for $account"
