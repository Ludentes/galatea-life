#!/usr/bin/env bash
# The owner's commands for the Zigbee bridge (plan 4a; the backup's place from the install-core plan):
#   galatea-zigbee form --channel N [--replace-network]   forms the network, once
#   galatea-zigbee backup                                  keeps the data directory's network in
#                                                          GALATEA_SECRETS_BACKUPS/zigbee/: it holds the
#                                                          network key, so never in backups/; encrypted
#                                                          with age when GALATEA_SECRETS_RECIPIENT is set.
#                                                          bin/galatea-backup-secrets takes the newest one
#                                                          into the secrets archive
#   galatea-zigbee restore <file>                          puts a backup's files back into an empty data
#                                                          directory (a new box), each mode 0600
# The bridge refuses both while it runs, but sees itself running only in its own network namespace,
# so through `docker exec` they would always refuse, and from another container they would not see
# it. So this refuses while the bridge's service runs, then runs the command in a one-off container
# of the bridge's image, on its data directory, with nothing else started.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage="usage: galatea-zigbee form --channel N [--replace-network] | galatea-zigbee backup | galatea-zigbee restore <file>"
[ $# -ge 1 ] || die "$usage"
command=$1
shift
case "$command" in
  form) ;;
  backup) [ $# -eq 0 ] || die "$usage" ;;
  restore) [ $# -eq 1 ] || die "$usage" ;;
  *) die "$usage" ;;
esac

# `ps` lists the service's running and restarting containers, none when it is stopped.
if [ -n "$(docker compose ps -q zigbee-bridge 2>/dev/null)" ]; then
  die "the bridge's service is running: stop it first (docker compose stop zigbee-bridge), then start it again afterwards"
fi

run=(docker compose run --rm --no-deps -T)
if [ "$command" = backup ]; then
  kept=$(resolve "${GALATEA_SECRETS_BACKUPS:-./backups-secrets}")/zigbee
  recipient="${GALATEA_SECRETS_RECIPIENT:-}"
  [ -z "$recipient" ] || command -v age >/dev/null || die "GALATEA_SECRETS_RECIPIENT is set, and age is not installed (sudo apt install age)"
  mkdir -p "$kept"
  chmod 700 "$(dirname "$kept")" "$kept"
  name="zigbee-$(date -u +%Y%m%dT%H%M%SZ).json"
  "${run[@]}" -v "$kept:/backups/zigbee" zigbee-bridge node dist/cli.js backup --out "/backups/zigbee/$name"
  if [ -n "$recipient" ]; then
    (umask 077 && age -r "$recipient" <"$kept/$name" >"$kept/$name.age.partial")
    [ "$(head -c 21 "$kept/$name.age.partial")" = "age-encryption.org/v1" ] || { rm -f "$kept/$name.age.partial"; die "age wrote nothing; $kept/$name is kept in clear"; }
    mv "$kept/$name.age.partial" "$kept/$name.age"
    rm -f "$kept/$name"
    echo "galatea-zigbee: encrypted to $kept/$name.age; this box keeps no readable copy"
  fi
  exit 0
fi
if [ "$command" = restore ]; then
  file=$(readlink -f "$1")
  [ -f "$file" ] || die "no such file: $1"
  case "$file" in *.age) die "$1 is encrypted: decrypt it first (age -d -i <your key> $1 > <file>.json)" ;; esac
  # node in the bridge's image writes each file of the backup, never over one, and refuses a data
  # directory that already holds a network.
  exec "${run[@]}" -v "$file:/in/backup.json:ro" --entrypoint node zigbee-bridge -e '
    const fs = require("node:fs");
    const b = JSON.parse(fs.readFileSync("/in/backup.json", "utf8"));
    if (b.format !== "galatea-zigbee-bridge-backup" || !b.files || typeof b.files["network.json"] !== "string") {
      console.error("galatea-zigbee: not a bridge backup with a network"); process.exit(2);
    }
    if (fs.existsSync("/data/network.json")) {
      console.error("galatea-zigbee: the data directory already holds a network: refusing to restore over it"); process.exit(2);
    }
    for (const [name, text] of Object.entries(b.files)) {
      if (!/^[a-z_]+\.(json|db)$/.test(name)) { console.error(`galatea-zigbee: refusing the file name ${name}`); process.exit(2); }
      fs.writeFileSync(`/data/${name}`, text, { mode: 0o600, flag: "wx" });
    }
    console.log(`galatea-zigbee: restored ${Object.keys(b.files).join(", ")} (taken ${b.takenAt})`);'
fi
exec "${run[@]}" zigbee-bridge node dist/cli.js form "$@"
