# Copy to .env and edit. Compose and the scripts in bin/ read it.

# The Postgres major. Change it only through bin/galatea-db-upgrade.
PG_MAJOR=18

# Your user and group (`id -u`, `id -g`): the services run as you and read your secret files.
GALATEA_UID=1000
GALATEA_GID=1000

# When the nightly backup runs, in TZ, and how many dumps are kept.
GALATEA_BACKUP_AT=03:30
GALATEA_BACKUP_KEEP=14
TZ=UTC

# Where things live. Relative paths are relative to this directory.
# GALATEA_BACKUPS may be a NAS mount. GALATEA_SECRETS_BACKUPS holds the secrets archive
# (bin/galatea-backup-secrets): no service mounts it, and it must not be GALATEA_BACKUPS.
GALATEA_BACKUPS=./backups
GALATEA_SECRETS_BACKUPS=./backups-secrets
GALATEA_SECRETS=./secrets
GALATEA_TLS=./tls
GALATEA_INSTANCES=./instances

# An age public key: the secrets archive is then encrypted to it, and the box keeps no readable copy.
# GALATEA_SECRETS_RECIPIENT=age1...

# Names or addresses every server certificate carries besides its service's name, localhost and
# 127.0.0.1: the box's LAN name or address, for a client on another box. Separated by commas, no
# spaces. Run bin/galatea-certs after a change.
# GALATEA_TLS_NAMES=galatea-box.home.arpa,192.0.2.10

# The ports the applier and the steward are published on, on this box's loopback only.
GALATEA_APPLIER_PORT=18443
GALATEA_STEWARD_PORT=18444

# The broker on the LAN, for a bridge on another box (compose.lan.yaml): this box's LAN address.
# GALATEA_LAN_ADDRESS=192.0.2.10
# COMPOSE_FILE=compose.yaml:compose.lan.yaml

# The broker's topic root, which the applier and every bridge share.
GALATEA_ROOT=galatea

# The Zigbee bridge (plan 4a). Uncomment to run it, and add bridge_zigbee to instances.
# COMPOSE_PROFILES=zigbee
# The coordinator, tcp://host:port.
# GALATEA_ZIGBEE_COORDINATOR=tcp://zigbee-coordinator.lan:6638
# 1 withholds every action, configure and provisioning: nothing is sent to a device.
# Start with it on a network you are only reading.
# GALATEA_ZIGBEE_NO_ACTIONS=1
# 1 writes herdsman's debug lines to the bridge's log, for a fault that needs the radio's side.
# GALATEA_ZIGBEE_DEBUG=1
# The bridge's data directory: the network key, the coordinator's backup, herdsman's database.
GALATEA_ZIGBEE_DATA=./zigbee
