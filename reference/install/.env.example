# Copy to .env and edit. Compose and the scripts in bin/ read it.

# The Postgres major. Change it only through bin/galatea-db-upgrade.
PG_MAJOR=18

# Your user and group, so backups on the host belong to you (`id -u`, `id -g`).
GALATEA_UID=1000
GALATEA_GID=1000

# When the nightly backup runs, in TZ, and how many dumps are kept.
GALATEA_BACKUP_AT=03:30
GALATEA_BACKUP_KEEP=14
TZ=UTC

# Where things live. Relative paths are relative to this directory.
# GALATEA_BACKUPS may be a NAS mount.
GALATEA_BACKUPS=./backups
GALATEA_DB_SECRETS=./secrets/db
GALATEA_BROKER_SECRETS=./secrets/broker
GALATEA_INSTANCES=./instances

# The broker's topic root, which the applier and every bridge share.
GALATEA_ROOT=galatea

# The Zigbee bridge (plan 4a). Uncomment to run it, and add bridge_zigbee to instances.
# COMPOSE_PROFILES=zigbee
# The coordinator, tcp://host:port.
# GALATEA_ZIGBEE_COORDINATOR=tcp://zigbee-coordinator.lan:6638
# 1 withholds every action, configure and provisioning: nothing is sent to a device.
# Start with it on a network you are only reading.
# GALATEA_ZIGBEE_NO_ACTIONS=1
# The bridge's data directory: the network key, the coordinator's backup, herdsman's database.
GALATEA_ZIGBEE_DATA=./zigbee
