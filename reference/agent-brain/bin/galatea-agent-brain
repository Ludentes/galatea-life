#!/bin/sh
# Starts a coding agent as a brain on the steward (the install-core design, *How the owner and a
# brain reach the steward*). Run it as the brain's own account, never the owner's:
#   galatea-agent-brain [command [args...]]     the agent tool; Claude Code when none is given, with
#                                               AGENTS.md appended to its system prompt and
#                                               claude-settings.json as its settings
# It reads the brain's two files from ~/.config/galatea/ (GALATEA_BRAIN_CONFIG), as
# `galatea-secret <id> --for <account>` installs them: the credential <id> (GALATEA_BRAIN_ID,
# brain_agent by default) and ca.pem. It sets, for the agent's process alone:
# - GALATEA_BRAIN_CREDENTIAL, which .mcp.json's Authorization header expands;
# - NODE_EXTRA_CA_CERTS, the installation's CA added to the agent's own trust (GA-BRAIN-16);
# - GALATEA_STEWARD_URL, https://127.0.0.1:18444/mcp unless set;
# then runs the agent in this directory, so it reads .mcp.json and AGENTS.md, which points it to the
# skill in skills/. (No CLAUDE.md: the export never publishes one, so Claude Code gets AGENTS.md
# through --append-system-prompt.)
set -eu
die() { echo "galatea-agent-brain: $*" >&2; exit 1; }
here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
id=${GALATEA_BRAIN_ID:-brain_agent}
dir=${GALATEA_BRAIN_CONFIG:-${HOME:?}/.config/galatea}

[ "$(id -u)" != 0 ] || die "not as root: a brain runs under an account of its own"
if id -nG | tr ' ' '\n' | grep -qx docker; then
  die "this account is in the docker group, which reads every container's mounts and so every secret: use the brain's own account"
fi
[ -s "$dir/$id" ] || die "no credential $dir/$id (galatea-secret $id --for $(id -un), on the box)"
[ -s "$dir/ca.pem" ] || die "no $dir/ca.pem (galatea-secret $id --for $(id -un), on the box)"

GALATEA_BRAIN_CREDENTIAL=$(cat "$dir/$id")
NODE_EXTRA_CA_CERTS=$dir/ca.pem
GALATEA_STEWARD_URL=${GALATEA_STEWARD_URL:-https://127.0.0.1:18444/mcp}
export GALATEA_BRAIN_CREDENTIAL NODE_EXTRA_CA_CERTS GALATEA_STEWARD_URL
cd "$here"
[ $# -gt 0 ] || set -- claude --settings "$here/claude-settings.json" --append-system-prompt "$(cat "$here/AGENTS.md")"
exec "$@"
